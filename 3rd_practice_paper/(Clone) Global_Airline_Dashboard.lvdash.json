    {
      "name": "9ca33cc5",
      "displayName": "Annual Global Airline Booking Performance Summary",
      "queryLines": [
        "SELECT\n",
        "    ROUND(SUM(annual_net_revenue), 2)                        AS net_revenue,\n",
        "    SUM(distinct_booking)                                    AS distinct_bookings,\n",
        "    SUM(active_passengers)                                    AS active_passengers,\n",
        "    ROUND(SUM(annual_net_revenue) / SUM(distinct_booking), 2) AS average_booking_value\n",
        "FROM global_airline.gold.vw_annual_booking_kpis"
      ]
    },
    {
      "name": "bookings",
      "displayName": "bookings",
      "config": {
        "source": "global_airline.silver.booking",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Number of non-cancelled bookings",
            "displayName": "Count"
          }
        ],
        "filter": "bk_status <> 'C'",
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ]
      }
    },
    {
      "name": "top10_passengers",
      "displayName": "Top 10 Passengers by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT p.pa_passengerid AS passenger_id, p.pa_name AS passenger_name,\n       SUM(b.bk_totalprice) AS passenger_revenue\nFROM global_airline.silver.booking b\nJOIN global_airline.gold.dim_passenger p ON b.bk_passengerid = p.pa_passengerid\nWHERE b.bk_status <> 'C'\nGROUP BY p.pa_passengerid, p.pa_name\nORDER BY passenger_revenue DESC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "passenger_name",
            "expr": "source.passenger_name",
            "displayName": "Passenger"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "passenger_revenue",
            "expr": "SUM(source.passenger_revenue)",
            "comment": "Net booking revenue for the passenger (non-cancelled bookings)"
          }
        ]
      }
    },
    {
      "name": "top10_routes",
      "displayName": "Top 10 Routes by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT r.ro_routeid AS route_id, r.ro_name AS route_name,\n       SUM(f.fb_ticketprice * f.fb_seats * (1 - f.fb_discount)) AS route_revenue\nFROM global_airline.gold.fact_bookings f\nJOIN global_airline.gold.dim_route r ON f.fb_routeid = r.ro_routeid\nGROUP BY r.ro_routeid, r.ro_name\nORDER BY route_revenue DESC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "route_name",
            "expr": "source.route_name",
            "displayName": "Route"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "route_revenue",
            "expr": "SUM(source.route_revenue)",
            "comment": "Net segment revenue for the route (ticket price x seats x (1 - discount))"
          }
        ]
      }
    },
    {
      "name": "bottom10_routes",
      "displayName": "Bottom 10 Routes by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT r.ro_routeid AS route_id, r.ro_name AS route_name,\n       SUM(f.fb_ticketprice * f.fb_seats * (1 - f.fb_discount)) AS route_revenue\nFROM global_airline.gold.fact_bookings f\nJOIN global_airline.gold.dim_route r ON f.fb_routeid = r.ro_routeid\nGROUP BY r.ro_routeid, r.ro_name\nORDER BY route_revenue ASC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "route_name",
            "expr": "source.route_name",
            "displayName": "Route"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "route_revenue",
            "expr": "SUM(source.route_revenue)",
            "comment": "Net segment revenue for the route (ticket price x seats x (1 - discount))"
          }
        ]
      }
    },
    {
      "name": "top10_airlines",
      "displayName": "Top 10 Airlines by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT a.al_airlineid AS airline_id, a.al_name AS airline_name,\n       SUM(f.fb_ticketprice * f.fb_seats * (1 - f.fb_discount)) AS airline_revenue\nFROM global_airline.gold.fact_bookings f\nJOIN global_airline.gold.dim_airline a ON f.fb_airlineid = a.al_airlineid\nGROUP BY a.al_airlineid, a.al_name\nORDER BY airline_revenue DESC\nLIMIT 10\n",
        "dimensions": [
          {
            "name": "airline_name",
            "expr": "source.airline_name",
            "displayName": "Airline"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "airline_revenue",
            "expr": "SUM(source.airline_revenue)",
            "comment": "Net segment revenue for the airline (ticket price x seats x (1 - discount))"
          }
        ]
      }
    },
    {
      "name": "airline_concentration",
      "displayName": "Airline Revenue Concentration",
      "config": {
        "version": "1.1",
        "source": "SELECT a.al_name AS airline_name,\n       SUM(f.fb_ticketprice * f.fb_seats * (1 - f.fb_discount)) AS airline_revenue\nFROM global_airline.gold.fact_bookings f\nJOIN global_airline.gold.dim_airline a ON f.fb_airlineid = a.al_airlineid\nGROUP BY a.al_name\n",
        "dimensions": [
          {
            "name": "airline_name",
            "expr": "source.airline_name",
            "displayName": "Airline"
          },
          {
            "name": "revenue_tier",
            "expr": "CASE WHEN ROW_NUMBER() OVER (ORDER BY source.airline_revenue DESC, source.airline_name) <= 5 THEN 'Top 5 Airlines' ELSE 'All Other Airlines' END",
            "displayName": "Revenue Tier"
          }
        ],
        "measures": [
          {
            "displayName": "Net Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "airline_revenue",
            "expr": "SUM(source.airline_revenue)",
            "comment": "Net segment revenue (ticket price x seats x (1 - discount))"
          }
        ]
      }
    }
  ],
